import os

# Ollama configuration
OLLAMA_CONFIG = {
    'host': os.getenv('OLLAMA_HOST', 'http://localhost:11434'),
    'chat_model': os.getenv('CHAT_MODEL', 'phi4-mini'),
    # NOTE: a Chroma collection's dimension is pinned by the first
    # embedding written to it, so switching embedding models (e.g.
    # nomic-embed-text -> qwen3-embedding:0.6b) requires deleting the
    # existing CHROMA_DB_PATH and re-indexing.
    'embedding_model': os.getenv('EMBEDDING_MODEL', 'qwen3-embedding:0.6b'),
    # 30s is too short for a cold model load or a large model's first token;
    # this covers both the embedding call and the (usually much longer,
    # streamed) chat call since they share one client.
    'timeout': float(os.getenv('OLLAMA_TIMEOUT', 300)),
    'retry_attempts': int(os.getenv('OLLAMA_RETRY_ATTEMPTS', 3)),
}

# ChromaDB configuration
CHROMA_CONFIG = {
    'collection': os.getenv('CHROMA_COLLECTION', 'readme_rag'),
    'db_path': os.getenv('CHROMA_DB_PATH', './chroma_db'),
}

# Indexer configuration
INDEXER_CONFIG = {
    'chunk_size': int(os.getenv('CHUNK_SIZE', 800)),
    'chunk_overlap': int(os.getenv('CHUNK_OVERLAP', 100)),
}

# Chat configuration
CHAT_CONFIG = {
    'top_k': int(os.getenv('TOP_K', 3)),
    'reload_interval': int(os.getenv('RELOAD_INTERVAL', 30)),
    'max_context_length': int(os.getenv('MAX_CONTEXT_LENGTH', 8192)),
    'max_message_length': int(os.getenv('MAX_MESSAGE_LENGTH', 4000)),
    # Chroma L2 distance above which a retrieved chunk is treated as "not
    # actually relevant" and dropped rather than fed to the model. Unset
    # (default) disables filtering -- every chat query logs the closest
    # match's distance, so you can pick a real threshold from observed
    # values instead of a guessed one.
    'max_context_distance': (
        float(os.environ['MAX_CONTEXT_DISTANCE']) if os.getenv('MAX_CONTEXT_DISTANCE') else None
    ),
}
