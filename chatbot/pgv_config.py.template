import os

# Database configuration
DB_CONFIG = {
    'dbname': os.getenv('DB_NAME', ''),
    'user': os.getenv('DB_USER', ''),
    'password': os.getenv('DB_PASSWORD', ''),
    'host': os.getenv('DB_HOST', ''),
    'port': os.getenv('DB_PORT', 5432),
    'connect_timeout': int(os.getenv('DB_CONNECT_TIMEOUT', 5)),
}

# Connection pool sizing
DB_POOL_CONFIG = {
    'minconn': int(os.getenv('DB_POOL_MIN_CONN', 1)),
    'maxconn': int(os.getenv('DB_POOL_MAX_CONN', 10)),
}

# Ollama configuration
OLLAMA_CONFIG = {
    'host': os.getenv('OLLAMA_HOST', 'http://'),
    'chat_model': os.getenv('CHAT_MODEL', 'phi4-mini'),
    'embedding_model': os.getenv('EMBEDDING_MODEL', 'qwen3-embedding:0.6b'),
    # Output dimension of the embedding model above (qwen3-embedding:0.6b
    # -> 1024, nomic-embed-text -> 768). Must match the vector(N) column in
    # pgvector.sql; the app resizes an *empty* markdown_chunks table to
    # match at startup, but a populated one must be re-indexed after a
    # model switch (embeddings from different models are incompatible).
    'embedding_dim': int(os.getenv('EMBEDDING_DIM', 1024)),
    # 30s is too short for a cold model load or a large model's first token;
    # this covers both the embedding call and the (usually much longer,
    # streamed) chat call since they share one client.
    'timeout': float(os.getenv('OLLAMA_TIMEOUT', 300)),
    'retry_attempts': int(os.getenv('OLLAMA_RETRY_ATTEMPTS', 3)),
    # Context window the chat model is loaded with. Must match what the
    # model is already running with on the server (262144 for
    # qwen3.8:27b-mtp-bf16) -- any other num_ctx forces a full model
    # reload on the first chat call.
    'num_ctx': int(os.getenv('LLM_NUM_CTX', 262144)),
    # Sent with every chat/embedding call so app requests never reset the
    # models' unload timer to the server's 5-minute default. -1 keeps a
    # model loaded forever; any other value is seconds.
    'keep_alive': int(os.getenv('OLLAMA_KEEP_ALIVE_SECONDS', -1)),
}

# Indexer configuration
INDEXER_CONFIG = {
    'chunk_size': int(os.getenv('CHUNK_SIZE', 800)),
    'chunk_overlap': int(os.getenv('CHUNK_OVERLAP', 100))
}

# Chat configuration
CHAT_CONFIG = {
    'top_k': int(os.getenv('TOP_K', 10)),
	'top_p': float(os.getenv('TOP_P', 0.9)),
    'reload_interval': int(os.getenv('RELOAD_INTERVAL', 30)),
    'max_message_length': int(os.getenv('MAX_MESSAGE_LENGTH', 4000)),
    # pgvector L2 distance above which a retrieved chunk is treated as "not
    # actually relevant" and dropped rather than fed to the model. Unset
    # (default) disables filtering -- every log line for a chat query logs
    # the closest match's distance, so you can pick a real threshold from
    # observed values instead of a guessed one.
    'max_context_distance': (
        float(os.environ['MAX_CONTEXT_DISTANCE']) if os.getenv('MAX_CONTEXT_DISTANCE') else None
    ),
}
