# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit it.

# --- Postgres (pgvector backend) ---
DB_NAME=chatbot
DB_USER=chatbot
DB_PASSWORD=
DB_HOST=db

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
CHAT_MODEL=phi4-mini
EMBEDDING_MODEL=snowflake-arctic-embed

# --- Google Drive OAuth (see gdrive_config.py.template) ---
# Client ID/secret come from a Google Cloud "Web application" OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI registered on that client.
GOOGLE_REDIRECT_URI=https://chatty.ifthenelse.net:7860/oauth2callback
# Required to hit GET /connect-drive. Generate with: openssl rand -hex 32
GDRIVE_ADMIN_TOKEN=
GDRIVE_TOKEN_STORE=/data/gdrive_token.json
