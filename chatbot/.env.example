# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit it.

# --- Postgres (pgvector backend) ---
DB_NAME=chatbot
DB_USER=chatbot
DB_PASSWORD=
DB_HOST=db

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
CHAT_MODEL=phi4-mini
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Output dimension of EMBEDDING_MODEL (qwen3-embedding:0.6b -> 1024,
# nomic-embed-text -> 768). Must match vector(N) in pgvector.sql.
EMBEDDING_DIM=1024
# Context window the chat model is loaded with. Must match what the model
# is already running with on the Ollama server (qwen3.8:27b-mtp-bf16 ->
# 262144); any other value forces a full model reload on the first chat.
LLM_NUM_CTX=262144
# Seconds a model stays loaded after each request. -1 = loaded forever.
OLLAMA_KEEP_ALIVE_SECONDS=-1

# --- Google sign-in + Drive OAuth (see gdrive_config.py.template) ---
# Client ID/secret come from a Google Cloud "Web application" OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI registered on that client.
GOOGLE_REDIRECT_URI=https://chatty.ifthenelse.net:7860/oauth2callback
GDRIVE_TOKEN_STORE=/data/gdrive_token.json

# --- App login (gates the whole UI, see auth_routes.py) ---
# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Comma-separated Google account emails allowed to log in. Empty = nobody
# can log in (fails closed).
ALLOWED_EMAILS=you@example.com
# Temporary LAN/debug escape hatch: 1 disables the sign-in gate entirely
# (no session, per-user history/feedback don't persist). OFF by default --
# only set it for internal networks, and remove it when you're done.
AUTH_DISABLED=0
